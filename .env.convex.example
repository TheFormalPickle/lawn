# Reference only: set these on the selected Convex DEVELOPMENT deployment.
# This file is not automatically imported by Convex. Do not paste real secrets here.
CLERK_JWT_ISSUER_DOMAIN=
# Self-hosted beta: AUTH_PROVIDER=oidc, exact public realm issuer and API audience.
# Keep clerk for an existing Clerk installation; unknown modes fail closed.
AUTH_PROVIDER=clerk
OIDC_ISSUER_DOMAIN=
OIDC_AUDIENCE=atrium-api
LAWN_BILLING_MODE=internal
# Per-team recorded active-file cap, expressed in GiB. Defaults to 100.
LAWN_INTERNAL_STORAGE_GB=100
# original: browser-supported NAS originals, no external transcoder/share links.
# mux: existing managed transcoding behavior (default).
LAWN_MEDIA_MODE=mux
RAILWAY_ENDPOINT=
RAILWAY_BUCKET_NAME=
RAILWAY_REGION=us-east-1
RAILWAY_ACCESS_KEY_ID=
RAILWAY_SECRET_ACCESS_KEY=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
# Required when the app issues signed playback or thumbnail tokens. Keep the PEM
# on the backend only; escaped \\n line breaks are supported by convex/mux.ts.
MUX_SIGNING_KEY=
MUX_PRIVATE_KEY=
