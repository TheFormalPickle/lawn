# Web application only. Copy to .env.local; keep real values out of Git.
# The Convex CLI will write the selected development deployment URL.
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
# Default remains clerk for existing installations. Self-hosted beta: keycloak.
VITE_AUTH_PROVIDER=clerk
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Required only for keycloak mode. No client secret belongs in the browser.
VITE_OIDC_URL=
VITE_OIDC_REALM=atrium
VITE_OIDC_CLIENT_ID=atrium-web
